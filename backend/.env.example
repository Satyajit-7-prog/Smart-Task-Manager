# Database connection URI
# SQLite example: sqlite:///./smart_task_manager.db
# PostgreSQL example: postgresql://username:password@host:port/dbname
DATABASE_URL=sqlite:///./smart_task_manager.db

# Secret key used for signing JWT Authentication tokens (Change this in production!)
SECRET_KEY=change-this-to-a-secure-secret-key-in-production

# Optional: OpenAI API Key for advanced AI features
OPENAI_API_KEY=
